# Binance API (trading permissions only — no withdrawal rights)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL_TO=your_email@gmail.com

# Dashboard authentication (Phase 13, audit fix C-4).
# When set, all /api/* endpoints require an `X-API-Key: <value>` header.
# Generate a strong value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED in live mode when dashboard.require_auth: true (default).
DASHBOARD_API_KEY=
